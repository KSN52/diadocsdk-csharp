package CryptoKit;

{$R *.res}

requires
  rtl,
  vcl;

contains
  CryptoKit in 'CryptoKit.pas',
  CryptoKit.Types in 'CryptoKit.Types.pas',
  CryptoKit.Exceptions in 'CryptoKit.Exceptions.pas',
